{
  // Dev-Container für ein neues Groovy/Grails-Projekt auf Ubuntu 24.04.
  "name": "Groovy-Grails-Ubuntu-24.04",
  "build": {
    // Ubuntu 24.04 als Basisschicht, damit das Team auf einem klar definierten Host-OS arbeitet.
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // VSCode spezifische Anpassungen
  "customizations": {
    "vscode": {
      "settings": {
        // Konsistente Shell- und Java-Umgebung im Container.
        "terminal.integrated.defaultProfile.linux": "bash",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/home/ubuntu/.sdkman/candidates/java/current",
            "default": true
          }
        ]
      },
      "extensions": [
        // "tomaszrup.groovy-spock-support", // Braucht JDK21, momentan nicht moeglich
        "bierner.markdown-mermaid",
        "marlon407.code-groovy",
        "GDOTecnologia.gfvscode",
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot"
      ]
    }
  },
  // Unter Linux sorgt das fuer konsistente Dateirechte im gemounteten Workspace.
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  // VS Code mounts the local folder to /workspaces/<folder-name> by default.
  // Ein Symlink ~/ufg -> /workspaces/urban-flow-governance wird per onCreateCommand gesetzt (s. u.).
  "workspaceFolder": "/workspaces/urban-flow-governance",
  // Legt den Symlink ~/ufg an – einmalig nach Container-Erstellung (cross-platform sicher).
  "onCreateCommand": "ln -sf /workspaces/urban-flow-governance /home/ubuntu/ufg",
  "postCreateCommand": "java -version && groovy --version && grails --version || true",
  "postStartCommand": "sudo service postgresql start",
  "containerEnv": {
    // PostgreSQL wird im Container vorkonfiguriert mit den folgenden Credentials.
    "DB_HOST": "localhost",
    "DB_PORT": "5432",
    "DB_NAME": "elgreti",
    "DB_USER": "elgreti",
    "DB_PASSWORD": "elgreti"
  },
  // Fedora/RHEL SELinux würde den Bind-Mount blockieren (user_home_t → container domain).
  // label:disable schaltet die SELinux-Label-Prüfung für diesen Container aus.
  "runArgs": ["--security-opt", "label=disable"],
  // Gibt Port 8080 frei um auf die Grails App zugreifen zu können
  "forwardPorts": [8080, 80, 443],
  "portsAttributes": {
    "8080": {
      "label": "Tomcat / Grails App",
      "onAutoForward": "notify"
    },
    "80": {
      "label": "Apache2 http",
      "onAutoForward": "notify"
    },
    "443": {
      "label": "Apache2 https",
      "onAutoForward": "notify"
    }
  }
}
