#!/bin/sh

REMOTE_USER="kobilarov"
REMOTE_HOST="iu.servicecluster.de"
REMOTE_PORT="11422"
REMOTE_PATH="/media/sf_iu/daps-ss26/elgreti/webclient/"
SSH_KEY="$HOME/.ssh/iu"

# Only deploy when pushing main
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    # Check if the push contains any frontend changes
    if git diff-tree --no-commit-id -r --name-only "$remote_sha" "$local_sha" | grep -q "^frontend/"; then
      echo "frontend/ changed — deploying to Apache..."
      scp -P "$REMOTE_PORT" -i "$SSH_KEY" -o StrictHostKeyChecking=no \
        frontend/app.js \
        frontend/config.js \
        frontend/index.html \
        frontend/style.css \
        "$REMOTE_USER@$REMOTE_HOST:$REMOTE_PATH" \
        && echo "Deploy successful." \
        || echo "Deploy failed — check SSH key at $SSH_KEY"
    fi
  fi
done
