#!/bin/sh

REMOTE_PATH="/media/sf_iu/daps-ss26/elgreti/webclient/"

ZERO_SHA="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
      CHANGED=$(git diff-tree --no-commit-id -r --name-only "$local_sha")
    else
      CHANGED=$(git log --name-only --pretty=format: "$remote_sha..$local_sha")
    fi

    if echo "$CHANGED" | grep -q "^frontend/"; then
      echo "frontend/ changed — deploying to Apache..."
      scp -o StrictHostKeyChecking=no \
        frontend/app.js \
        frontend/config.js \
        frontend/index.html \
        frontend/style.css \
        "iu-deploy:$REMOTE_PATH" \
        && echo "Deploy successful." \
        || echo "Deploy failed — check ~/.ssh/config for iu-deploy entry"
    fi
  fi
done
